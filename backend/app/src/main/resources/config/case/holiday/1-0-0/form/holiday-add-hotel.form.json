{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "Instructions",
            "content": "Add the hotel for this holiday.",
            "tableView": false,
            "refreshOnChange": false
        },
        {
            "key": "hotel",
            "type": "textfield",
            "input": true,
            "label": "Hotel",
            "tableView": true,
            "applyMaskOn": "change",
            "validate": {
                "required": true
            }
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Save",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
