<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="holiday-participant" name="Holiday Process" processRef="holiday-process" />
  </bpmn:collaboration>
  <bpmn:process id="holiday-process" name="Holiday Process" isExecutable="true">
    <bpmn:startEvent id="start-event" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="Gateway_0khy3l1" />
    <bpmn:userTask id="add_rooms" name="Add rooms">
      <bpmn:incoming>Flow_0gxtyan</bpmn:incoming>
      <bpmn:outgoing>Flow_1b9ll74</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1g0j4gm" sourceRef="Gateway_0khy3l1" targetRef="add_activities" />
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:incoming>Flow_0syncend</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_097rozg">
      <bpmn:incoming>Flow_0oa4pqw</bpmn:incoming>
      <bpmn:incoming>Flow_1b9ll74</bpmn:incoming>
      <bpmn:outgoing>Flow_043oqm3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0oa4pqw" sourceRef="add_activities" targetRef="Gateway_097rozg" />
    <bpmn:sequenceFlow id="Flow_1b9ll74" sourceRef="add_rooms" targetRef="Gateway_097rozg" />
    <bpmn:sequenceFlow id="Flow_043oqm3" sourceRef="Gateway_097rozg" targetRef="check_participants" />
    <bpmn:userTask id="check_participants" name="Check participants">
      <bpmn:incoming>Flow_043oqm3</bpmn:incoming>
      <bpmn:incoming>Flow_0notenough</bpmn:incoming>
      <bpmn:outgoing>Flow_0checkgw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0checkgw" sourceRef="check_participants" targetRef="Gateway_enough" />
    <bpmn:exclusiveGateway id="Gateway_enough" name="Enough participants?">
      <bpmn:incoming>Flow_0checkgw</bpmn:incoming>
      <bpmn:outgoing>Flow_0enough</bpmn:outgoing>
      <bpmn:outgoing>Flow_0notenough</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0enough" name="Yes" sourceRef="Gateway_enough" targetRef="sync_participants">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${enoughParticipants == 'yes'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0notenough" name="No" sourceRef="Gateway_enough" targetRef="check_participants">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${enoughParticipants != 'yes'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="sync_participants" name="Sync participants">
      <bpmn:incoming>Flow_0enough</bpmn:incoming>
      <bpmn:outgoing>Flow_0syncend</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0syncend" sourceRef="sync_participants" targetRef="end-event" />
    <bpmn:userTask id="add_activities" name="Add activities">
      <bpmn:incoming>Flow_1g0j4gm</bpmn:incoming>
      <bpmn:outgoing>Flow_0oa4pqw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0px6xzg" sourceRef="Gateway_0khy3l1" targetRef="add_hotel" />
    <bpmn:sequenceFlow id="Flow_0gxtyan" sourceRef="add_hotel" targetRef="add_rooms" />
    <bpmn:userTask id="add_hotel" name="Add hotel">
      <bpmn:incoming>Flow_0px6xzg</bpmn:incoming>
      <bpmn:outgoing>Flow_0gxtyan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_0khy3l1">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1g0j4gm</bpmn:outgoing>
      <bpmn:outgoing>Flow_0px6xzg</bpmn:outgoing>
    </bpmn:parallelGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="holiday-participant" isHorizontal="true">
