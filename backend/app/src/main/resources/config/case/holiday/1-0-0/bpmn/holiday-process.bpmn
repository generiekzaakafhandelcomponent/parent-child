      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1rzlz7p_di" bpmnElement="Gateway_097rozg">
        <dc:Bounds x="795" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1nkdcoh_di" bpmnElement="add_activities">
        <dc:Bounds x="650" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1ci0up9_di" bpmnElement="add_hotel">
        <dc:Bounds x="480" y="290" width="100" height="80" />
